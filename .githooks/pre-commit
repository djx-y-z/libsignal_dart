#!/bin/bash
#
# Pre-commit hook for libsignal
#
# Runs format check, Rust check and static analysis before each commit.
# To skip this hook, use: git commit --no-verify
#

set -e

# Git hands every hook a GIT_DIR pointing at the repository being committed to,
# and any child process inherits it. In an ordinary checkout that is the
# relative string `.git`, which is harmless: a tool that chdirs elsewhere
# re-resolves it against its own directory. For a *worktree* it is necessarily
# an absolute path — `.git` there is a file, not a directory — and it then
# follows every child process everywhere it goes.
#
# That breaks any tool downstream that asks git about itself. `flutter` does
# exactly that to work out its own version: run from a worktree's hook it read
# THIS repository's HEAD instead of its own, found no Flutter tag on it, and
# wrote `"frameworkVersion": "0.0.0-unknown"` into the pinned SDK's
# `bin/cache/flutter.version.json`. That file is a cache, so the damage outlived
# the hook — every later `flutter` and `dart` invocation, inside a hook or not,
# then failed version solving with "The current Flutter SDK version is
# 0.0.0-unknown" until it was deleted by hand.
#
# Measured rather than reasoned: with GIT_DIR set to a worktree's gitdir,
# `git -C <flutter-sdk> describe --tags` answers with this repository's tag.
# GIT_INDEX_FILE and GIT_WORK_TREE go with it for the same reason — the checks
# below need none of the three, and a tool that wants this repository can still
# find it from the working directory the hook already runs in.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# git does not necessarily run this hook from a login shell: IDEs and GUI git
# clients inherit a minimal PATH, so `make`, `fvm` and `cargo` can all be
# missing even though they work fine in a terminal. Restore the usual install
# locations *before* the first check runs — otherwise the checks below fail with
# "command not found" and the failure gets reported as whatever the first check
# happened to be.
#
# Appended, not prepended: a tool deliberately placed earlier in PATH must keep
# winning. Both the Unix (~/.pub-cache) and the Windows/Git-Bash
# (%LOCALAPPDATA%\Pub\Cache) pub-cache layouts are listed, and PUB_CACHE /
# CARGO_HOME are honoured when set. Only directories that exist and are not
# already present get added.
for _dir in \
    "${PUB_CACHE:-$HOME/.pub-cache}/bin" \
    "${LOCALAPPDATA:-}/Pub/Cache/bin" \
    "$HOME/fvm/default/bin" \
    "${CARGO_HOME:-$HOME/.cargo}/bin" \
    /opt/homebrew/bin \
    /usr/local/bin
do
    if [ -d "$_dir" ]; then
        case ":$PATH:" in
            *":$_dir:"*) ;;
            *) PATH="$PATH:$_dir" ;;
        esac
    fi
done
unset _dir
export PATH

# Report a missing toolchain as a missing toolchain. Without this the hook says
# "Formatting check failed. Run 'make format'" when the real problem is that fvm
# is not on PATH — which sends you looking at your code instead of your PATH.
missing=""
for tool in make fvm cargo; do
    command -v "$tool" >/dev/null 2>&1 || missing="$missing $tool"
done
if [ -n "$missing" ]; then
    echo -e "${RED}Pre-commit checks cannot run: not found on PATH —${missing}${NC}"
    echo -e "${YELLOW}This usually means git was started from an IDE or GUI client${NC}"
    echo -e "${YELLOW}with a minimal PATH. Commit from a terminal, or install the${NC}"
    echo -e "${YELLOW}missing tool(s) with 'make setup'.${NC}"
    echo -e "${YELLOW}To bypass (checks NOT run): git commit --no-verify${NC}"
    exit 1
fi

# run_step <n> <label> <fix-hint> <command...>
#
# Exit code 127 is reported separately: it means a command inside the make
# recipe was not found, which is a broken environment rather than a failing
# check, and the fix hint would be actively misleading.
run_step() {
    local num="$1" label="$2" hint="$3"
    shift 3
    echo -e "\n${YELLOW}[$num/3] $label...${NC}"
    if "$@"; then
        echo -e "${GREEN}$label passed.${NC}"
    else
        local status=$?
        if [ "$status" -eq 127 ]; then
            echo -e "${RED}$label could not run: a tool used by this step is missing (exit 127).${NC}"
            echo -e "${YELLOW}Fix the environment, not the code. Run 'make setup' or check PATH.${NC}"
        else
            echo -e "${RED}$label failed (exit $status).${NC}"
            echo -e "${YELLOW}$hint${NC}"
        fi
        exit 1
    fi
}

echo -e "${YELLOW}Running pre-commit checks...${NC}"

run_step 1 "Checking code formatting" \
    "Run 'make format' to fix formatting issues." \
    make format-check

run_step 2 "Checking Rust code" \
    "Fix the Rust errors above before committing." \
    make rust-check

run_step 3 "Running static analysis" \
    "Fix the issues above before committing." \
    make analyze ARGS="--fatal-infos"

echo -e "\n${GREEN}All pre-commit checks passed!${NC}"
