// OpenCode configuration for the build-repair agent.
//
// This file is the OpenCode counterpart to the `claude_args` block in
// `.github/workflows/repair-build.yml`. Both engines run the same prompt
// (`.github/agent-prompts/repair-build.md`) against the same evidence and are
// bound by the same path allowlist afterwards; only the way permissions are
// spelled differs.
//
// It deliberately lives under `.github/` rather than at the repository root:
// `.github/**` is outside the agent's path allowlist, so the agent cannot
// widen its own permissions and have the change ride along in the pull
// request. Keeping it out of the root also means it does not silently become
// the config for anyone running `opencode` in this repository by hand.
//
// JSONC: comments and trailing commas are supported by OpenCode's config
// parser. Verify any edit with `opencode debug config` before pushing.
{
  "$schema": "https://opencode.ai/config.json",

  // Deny by default, allow by exception. `ask` is never used anywhere in this
  // file on purpose: OpenCode does not document what an `ask` resolves to in a
  // headless run, and the two plausible answers are both bad — a silent denial
  // that looks like the agent choosing not to act, or a block that waits for an
  // approval that can never arrive and burns the job timeout instead.
  "permission": {
    // Every tool is named explicitly below rather than relying on a `"*"`
    // catch-all, and that is deliberate. A `"*": "deny"` entry here does work,
    // but where it lands in the resolved rule list is not stable: measured with
    // `opencode debug agent`, it sorted *before* the bash rules with no global
    // config present and *after* them when a `~/.config/opencode/opencode.json`
    // existed. Since evaluation is last-match-wins, the second ordering risks a
    // wildcard deny silently overriding the entire bash allowlist — a failure
    // that would depend on the machine rather than on this file.
    //
    // What a catch-all would have bought is protection against tools added by a
    // future OpenCode release. Pinning the version in the workflow buys that
    // more reliably, so the tool list below is exhaustive as of the pinned
    // version. Re-check it against `opencode debug agent` when bumping.
    //
    // The tools the agent genuinely needs. `write` is load-bearing and is NOT
    // one of the permission keys named in OpenCode's published schema — it is
    // accepted via `additionalProperties`. Leaving it unset would leave the
    // agent unable to create `.agent-scratch/verdict.json`, which the workflow
    // treats as "the agent did not finish" and fails on. Do not remove it.
    "read": "allow",
    "write": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",

    // Everything else is off. `webfetch`/`websearch` mirror the
    // `--disallowedTools` on the Claude Code side: the agent is told it has no
    // network and everything known about the run was already gathered for it.
    //
    // `question` matters more than it looks — a question in a headless run has
    // nobody to answer it. `external_directory` keeps file access inside the
    // workspace, which is the one thing the path allowlist cannot retroactively
    // undo, since a read of `/proc/self/environ` leaves no trace in the diff.
    // `task` (subagents) is denied because a subagent's permissions are its
    // own, and this file is only auditable if it describes the whole run.
    //
    // On `external_directory`, one observed detail worth keeping: denying it
    // also clobbers the built-in allows OpenCode adds for its own scratch
    // directories, because those come earlier and the last match wins. OpenCode
    // re-appends the allow for its tool-output directory *after* user config,
    // so that path survives; the OS temp directory allow does not. If a live
    // run fails on a temp-directory write, add a narrow allow for that exact
    // prefix here rather than relaxing this to `ask` — `ask` is what has no
    // defined meaning in a headless run.
    "patch": "deny",
    "task": "deny",
    "question": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "skill": "deny",
    "lsp": "deny",
    "todowrite": "deny",
    "doom_loop": "deny",
    "external_directory": "deny",

    // Commands are enumerated exactly, with no wildcards anywhere except the
    // leading deny-all. That is a deliberate difference from the Claude Code
    // side, which carries prefix forms like `Bash(make test:*)`.
    //
    // OpenCode matches these as glob patterns, so a trailing `*` would match
    // far more than the command it names: `"make test *"` also matches
    // `make test && make release`, and `make release` bumps `pubspec.yaml`,
    // which IS inside the path allowlist — so a version bump would ride along
    // in the pull request looking like part of the fix. Exact patterns cannot
    // absorb a `&&` clause, so the hole closes structurally rather than by
    // trying to blacklist shell operators.
    //
    // The five commands the prompt actually requires are all exact strings.
    // Add a pattern here only when a real run proves one is needed, and prefer
    // adding another exact line over introducing a `*`.
    //
    // `cargo` is absent entirely. The Claude Code allowlist enumerates
    // `cargo check:*` and friends, but CLAUDE.md tells the agent never to call
    // cargo directly, so granting it only creates a second way to reach
    // `cargo publish` / `cargo install`.
    "bash": {
      "*": "deny",

      // The five gates named in `.github/agent-prompts/repair-build.md`.
      "make build": "allow",
      "make test": "allow",
      "make analyze ARGS=\"--fatal-infos\"": "allow",
      "make format-check": "allow",
      "make rust-clippy": "allow",

      // Supporting targets: dependency fetch, codegen, and the formatter the
      // agent needs to satisfy `make format-check`.
      "make get": "allow",
      "make codegen": "allow",
      "make format": "allow",
      "make analyze": "allow",
      "make rust-check": "allow",
      "make rust-test": "allow",

      // Read-only inspection of its own work. Exact forms only.
      "git status": "allow",
      "git diff": "allow"
    }
  },

  "agent": {
    "repair-build": {
      "description": "Repairs a broken build on main and leaves a verdict.",
      "mode": "primary",

      // The `--max-turns 40` equivalent. OpenCode has no CLI flag for this; it
      // is agent configuration only. On exhaustion OpenCode forces a text-only
      // response rather than stopping outright, which means the agent cannot
      // call `write` to leave its verdict — so the missing `verdict.json` still
      // fails the workflow loudly, which is the behaviour we want.
      //
      // Prefer `steps` over `maxSteps`; the latter is deprecated in the schema.
      "steps": 40
    }
  }
}
